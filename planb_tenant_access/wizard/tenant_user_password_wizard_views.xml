<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_planb_tenant_user_password_wizard_form" model="ir.ui.view">
    <field name="name">planb.tenant.user.password.wizard.form</field>
    <field name="model">planb.tenant.user.password.wizard</field>
    <field name="arch" type="xml">
      <form string="Change User Password">
        <group>
          <field name="slot_id" />
          <field name="new_password" password="True" />
          <field name="confirm_password" password="True" />
        </group>
        <footer>
          <button name="action_change_password"
            type="object"
            string="Change Password"
            class="btn-primary" />
          <button string="Cancel" special="cancel" />
        </footer>
      </form>
    </field>
  </record>

  <record id="action_planb_tenant_user_password_wizard" model="ir.actions.act_window">
    <field name="name">Change User Password</field>
    <field name="res_model">planb.tenant.user.password.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>