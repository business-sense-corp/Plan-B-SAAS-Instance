<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="digest_mail_main_planb" name="Digest Mail Main Plan B" inherit_id="digest.digest_mail_main">
        <xpath expr="//div[contains(@class, 'by_odoo')]/a[@href='https://www.odoo.com']" position="replace">
            <a href="https://www.planb-hub.com" target="_blank">
                <span class="odoo_link_text">Plan B</span>
            </a>
        </xpath>
        <xpath expr="//p[@id='powered']/a[@href='https://www.odoo.com']" position="replace">
            <a href="https://www.planb-hub.com" target="_blank" class="odoo_link">
                <span class="odoo_link_text">Plan B</span>
            </a>
        </xpath>
        <xpath expr="//tr[@t-if='display_mobile_banner']" position="replace"/>
    </template>

    <record id="digest_digest_view_form_planb" model="ir.ui.view">
        <field name="name">digest.digest.view.form.planb</field>
        <field name="model">digest.digest</field>
        <field name="inherit_id" ref="digest.digest_digest_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='custom']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
