<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_planb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.planb</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_root_company']" position="before">
                <field name="planb_hide_system_settings" invisible="1"/>
            </xpath>
            <xpath expr="//div[@id='invite_users']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//setting[@id='companies_setting']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//button[@name='open_company']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//setting[@id='inter_company']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//div[@id='contacts_settings']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//setting[@id='email-alias-setting']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//setting[field[@name='module_google_gmail']]" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//setting[@id='email-outlook-setting']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//block[@id='user_default_rights']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//block[@name='integration']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//block[@name='performance']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
            <xpath expr="//widget[@name='res_config_dev_tool']" position="replace">
                <div id="planb_dev_tools_block" invisible="planb_hide_system_settings">
                    <widget name="res_config_dev_tool"/>
                </div>
            </xpath>
            <xpath expr="//div[@id='about']" position="attributes">
                <attribute name="invisible">planb_hide_system_settings</attribute>
            </xpath>
        </field>
    </record>
</odoo>
