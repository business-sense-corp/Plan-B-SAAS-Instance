<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_planb_tenant_user_slot_list" model="ir.ui.view">
    <field name="name">planb.tenant.user.slot.list</field>
    <field name="model">planb.tenant.user.slot</field>
    <field name="arch" type="xml">
      <list create="0" delete="0" editable="bottom">
        <field name="slot_number" readonly="1" />
        <field name="name" />
        <field name="login" />
        <field name="email" />
        <field name="access_all_modules" />
        <field name="module_ids" widget="many2many_tags"
          readonly="access_all_modules" />
      </list>
    </field>
  </record>

  <record id="view_planb_tenant_user_slot_form" model="ir.ui.view">
    <field name="name">planb.tenant.user.slot.form</field>
    <field name="model">planb.tenant.user.slot</field>
    <field name="arch" type="xml">
      <form string="Company User" create="0" delete="0">
        <header>
          <button name="%(action_planb_tenant_user_password_wizard)d"
            type="action"
            string="Change Password"
            class="btn-primary"
            context="{'default_slot_id': id}" />
        </header>
        <sheet>
          <group>
            <group string="User">
              <field name="slot_number" readonly="1" />
              <field name="name" />
              <field name="login" />
              <field name="email" />
            </group>
            <group string="Package Access">
              <field name="access_all_modules" />
              <field name="module_ids"
                widget="many2many_tags"
                readonly="access_all_modules"
                options="{'no_create': True, 'no_create_edit': True}" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_planb_tenant_user_slots" model="ir.actions.act_window">
    <field name="name">Company Users</field>
    <field name="res_model">planb.tenant.user.slot</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('slot_number', '&gt;', 1), ('active', '=', True)]</field>
    <field name="context">{'create': False, 'delete': False}</field>
  </record>

  <menuitem id="menu_planb_company_administration"
    name="Company Administration"
    sequence="90"
    groups="planb_tenant_access.group_planb_customer_admin" />

  <menuitem id="menu_planb_company_users"
    name="Company Users"
    parent="menu_planb_company_administration"
    action="action_planb_tenant_user_slots"
    sequence="10"
    groups="planb_tenant_access.group_planb_customer_admin" />
</odoo>