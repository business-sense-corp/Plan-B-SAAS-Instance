<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="group_planb_customer_admin" model="res.groups">
    <field name="name">Plan B Customer Administrator</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
  </record>

  <record id="rule_planb_customer_admin_slots" model="ir.rule">
    <field name="name">Customer admin: active employee slots only</field>
    <field name="model_id" ref="model_planb_tenant_user_slot" />
    <field name="groups" eval="[(4, ref('group_planb_customer_admin'))]" />
    <field name="domain_force">[('slot_number', '&gt;', 1), ('active', '=', True)]</field>
    <field name="perm_read">1</field>
    <field name="perm_write">1</field>
    <field name="perm_create">0</field>
    <field name="perm_unlink">0</field>
  </record>

  <record id="rule_planb_customer_admin_modules" model="ir.rule">
    <field name="name">Customer admin: current package modules only</field>
    <field name="model_id" ref="model_planb_tenant_module_access" />
    <field name="groups" eval="[(4, ref('group_planb_customer_admin'))]" />
    <field name="domain_force">[('active', '=', True)]</field>
    <field name="perm_read">1</field>
    <field name="perm_write">0</field>
    <field name="perm_create">0</field>
    <field name="perm_unlink">0</field>
  </record>
</odoo>