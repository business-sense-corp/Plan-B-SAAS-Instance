<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ==================================================================
             Self-contained page layout.

             `web.login_layout` is deliberately NOT used: it renders through
             `web.frontend_layout`, and on the management database `website`
             inherits that template and requires a `website` value in the
             qcontext. Depending on `website` would also make this module
             unusable on a tenant that does not install the Website app.

             This layout borrows only from `web`: `web.assets_frontend` and the
             company logo, so it works identically on the management server
             and on every tenant database.
             ================================================================== -->
        <template id="reset_page_layout" name="Password Reset Page Layout">&lt;!DOCTYPE html&gt;
<html t-att-lang="request.env.lang and request.env.lang.replace('_', '-') or 'en'">
    <head>
        <meta charset="utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Password reset</title>
        <link type="image/x-icon" rel="shortcut icon" t-att-href="'/web/static/img/favicon.ico'"/>
        <t t-call-assets="web.assets_frontend" t-js="false"/>
        <script type="text/javascript">
            var odoo = {
                csrf_token: "<t t-esc="request.csrf_token(None)"/>",
                debug: "",
            };
        </script>
    </head>
    <body class="bg-100">
        <div class="container py-5">
            <div class="card border-0 mx-auto bg-100 o_database_list" style="max-width: 380px;">
                <div class="card-body">
                    <div class="text-center pb-3 border-bottom mb-4">
                        <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                             alt="Logo"
                             style="max-height:120px; max-width: 100%; width:auto;"/>
                    </div>
                    <t t-out="0"/>
                </div>
            </div>
        </div>
    </body>
</html>
        </template>

        <!-- ==================================================================
             Step 1 - ask for the e-mail address
             ================================================================== -->
        <template id="forgot_password_form" name="Forgot Password - E-mail">
            <t t-call="planb_password_reset.reset_page_layout">
                <div class="oe_login_form">
                    <h4 class="text-center mb-2">Forgot your password?</h4>
                    <p class="text-muted small text-center mb-4">
                        Enter the e-mail address of your account and we will send
                        you a 6-digit verification code.
                    </p>

                    <div class="alert alert-danger" role="alert" aria-live="assertive" t-if="error">
                        <t t-out="error"/>
                    </div>

                    <form action="/web/forgot-password" method="post" role="form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="mb-3">
                            <label for="forgot_email" class="form-label">E-mail</label>
                            <input type="email"
                                   name="email"
                                   id="forgot_email"
                                   class="form-control"
                                   placeholder="you@example.com"
                                   required="required"
                                   autofocus="autofocus"
                                   autocapitalize="off"
                                   autocomplete="email"
                                   t-att-value="email"/>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                Send verification code
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <a href="/web/login" class="small">Back to login</a>
                    </div>
                </div>
            </t>
        </template>

        <!-- ==================================================================
             Step 2 - enter the code only. The password form is a separate
             page, rendered only after this code has been accepted.
             ================================================================== -->
        <template id="forgot_password_verify" name="Forgot Password - Verify">
            <t t-call="planb_password_reset.reset_page_layout">
                <div class="oe_login_form">
                    <h4 class="text-center mb-2">Check your e-mail</h4>

                    <div class="alert alert-info small" role="status" aria-live="polite" t-if="message">
                        <t t-out="message"/>
                    </div>
                    <div class="alert alert-danger" role="alert" aria-live="assertive" t-if="error">
                        <t t-out="error"/>
                    </div>

                    <t t-if="not request_token">
                        <p class="text-muted small text-center">
                            For security reasons you cannot retry this request.
                            Please start again to receive a new code.
                        </p>
                        <div class="d-grid">
                            <a href="/web/forgot-password" class="btn btn-primary">
                                Request a new code
                            </a>
                        </div>
                    </t>

                    <t t-else="">
                        <p class="text-muted small text-center mb-3">
                            Enter the 6-digit code we sent to
                            <strong t-out="email"/>. If it is correct, the next
                            page asks for your new password.
                        </p>

                        <form action="/web/forgot-password/verify" method="post" role="form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="request_token" t-att-value="request_token"/>

                            <div class="mb-3">
                                <label for="forgot_code" class="form-label">Verification code</label>
                                <input type="text"
                                       name="code"
                                       id="forgot_code"
                                       class="form-control text-center"
                                       style="letter-spacing: 8px; font-size: 22px;"
                                       placeholder="000000"
                                       required="required"
                                       autofocus="autofocus"
                                       inputmode="numeric"
                                       pattern="[0-9]*"
                                       maxlength="6"
                                       autocomplete="one-time-code"/>
                                <div class="form-text">The code expires in <t t-out="ttl"/> minutes.</div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    Verify code
                                </button>
                            </div>
                        </form>

                        <div class="text-center mt-4 pt-3 border-top">
                            <a href="/web/forgot-password" class="small">Send a new code</a>
                            <span class="text-muted small mx-2">&#183;</span>
                            <a href="/web/login" class="small">Back to login</a>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <!-- ==================================================================
             Step 3 - choose the new password.

             Rendered only by POST /web/forgot-password/verify when the code was
             correct. It carries two secrets in hidden fields, never in the URL:
             the request token and the single-use verification token, which is
             also bound to the browser session that verified the code.
             ================================================================== -->
        <template id="forgot_password_new_password" name="Forgot Password - New password">
            <t t-call="planb_password_reset.reset_page_layout">
                <div class="oe_login_form">
                    <h4 class="text-center mb-2">Choose a new password</h4>

                    <div class="alert alert-success small" role="status" aria-live="polite" t-if="not error">
                        Your code is correct. Set the new password for
                        <strong t-out="email"/> below.
                    </div>
                    <div class="alert alert-danger" role="alert" aria-live="assertive" t-if="error">
                        <t t-out="error"/>
                    </div>

                    <form action="/web/forgot-password/reset" method="post" role="form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="request_token" t-att-value="request_token"/>
                        <input type="hidden" name="verify_token" t-att-value="verify_token"/>

                        <div class="mb-3">
                            <label for="forgot_new_password" class="form-label">New password</label>
                            <input type="password"
                                   name="new_password"
                                   id="forgot_new_password"
                                   class="form-control"
                                   required="required"
                                   t-att-minlength="min_length"
                                   autofocus="autofocus"
                                   autocomplete="new-password"/>
                        </div>

                        <div class="mb-3">
                            <label for="forgot_confirm_password" class="form-label">Confirm new password</label>
                            <input type="password"
                                   name="confirm_password"
                                   id="forgot_confirm_password"
                                   class="form-control"
                                   required="required"
                                   t-att-minlength="min_length"
                                   autocomplete="new-password"/>
                            <div class="form-text">
                                At least <t t-out="min_length"/> characters. This
                                step stays available for <t t-out="ttl"/> minutes.
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                Change my password
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <a href="/web/login" class="small">Back to login</a>
                    </div>
                </div>
            </t>
        </template>

        <!-- ==================================================================
             Step 3 - success
             ================================================================== -->
        <template id="forgot_password_done" name="Forgot Password - Done">
            <t t-call="planb_password_reset.reset_page_layout">
                <div class="oe_login_form text-center">
                    <div class="mb-3" style="font-size: 42px; color: #16a34a;">
                        <i class="fa fa-check-circle" role="img" aria-label="Success"/>
                    </div>
                    <h4 class="mb-2">Password changed</h4>
                    <p class="text-muted small">
                        The password for <strong t-out="login"/> has been updated.
                        You can now sign in with your new password.
                    </p>
                    <p class="text-muted small" t-if="notified">
                        A confirmation has been sent to the e-mail address of the
                        account. If you did not make this change, contact your
                        administrator immediately.
                    </p>
                    <div class="d-grid mt-4">
                        <a href="/web/login" class="btn btn-primary">Go to login</a>
                    </div>
                </div>
            </t>
        </template>

        <!-- ==================================================================
             "Forgot your password?" link on the login page.

             NOTE: the `login` module of this repository hides anything whose
             href contains "/web/reset_password" (Odoo's built-in link flow).
             Our route is /web/forgot-password, so it is not hidden.
             ================================================================== -->
        <template id="login_forgot_password_link" inherit_id="web.login" priority="50">
            <xpath expr="//div[hasclass('oe_login_buttons')]" position="after">
                <div class="text-center mt-2">
                    <a href="/web/forgot-password" class="small text-decoration-none">
                        Forgot your password?
                    </a>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
